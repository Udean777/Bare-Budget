# ==============================================================================
# Bare Budget Server Environment Configuration
# ==============================================================================

# Server Environment: 'development', 'staging', or 'production'
ENV=development

# HTTP Server Port
PORT=8080

# Primary PostgreSQL Connection URL
# Local Development:
DATABASE_URL=host=localhost user=postgres password=postgres dbname=barebudget port=5432 sslmode=disable
# Production (Neon.tech example):
# DATABASE_URL=postgres://user:password@ep-sample-123.ap-southeast-1.aws.neon.tech/barebudget?sslmode=require

# CORS Allowed Origins (Comma-separated or '*' for dev)
CORS_ALLOWED_ORIGINS=*

# Firebase Service Account (Optional for full prod JWT validation)
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

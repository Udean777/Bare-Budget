# Copy this file to `.env.local` before running `vercel dev`.
# `.env.local` is ignored by Git and must never be bundled into the APK.
# Create a Gemini key at https://aistudio.google.com/.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=replace-with-gemini-model
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Required: persistent Vercel KV/Upstash REST credentials for rate limiting.
# These names match the `bareuang` Vercel integration prefix.
bareuang_KV_REST_API_URL=https://replace-with-kv-endpoint
bareuang_KV_REST_API_TOKEN=replace-with-kv-token

# Optional limits (per UTC day).
RATE_LIMIT_RPD=20
RATE_LIMIT_IP_RPD=60
GLOBAL_LIMIT_RPD=5000

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://bareuang.vercel.app,http://localhost:3000
